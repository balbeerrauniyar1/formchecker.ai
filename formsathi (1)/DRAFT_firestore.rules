rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Catch-all deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Global Functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidId(id) { 
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); 
    }
    
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    // User Validation Helpers
    function isValidUser(data) {
      return data.keys().hasAll(['id', 'email', 'createdAt', 'updatedAt']) 
        && data.id == request.auth.uid
        && data.email is string && data.email.size() <= 200
        && data.createdAt == request.time
        && data.updatedAt == request.time;
    }

    function isValidUserUpdate(data) {
      return data.keys().hasAll(['id', 'email', 'createdAt', 'updatedAt']) 
        && data.id == request.auth.uid
        && data.email is string && data.email.size() <= 200
        && data.updatedAt == request.time;
    }

    // Match Users
    match /users/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      
      allow create: if isVerifiedUser() 
        && isValidId(userId)
        && userId == request.auth.uid
        && isValidUser(incoming());

      allow update: if isVerifiedUser() 
        && userId == request.auth.uid
        && isValidUserUpdate(incoming())
        && incoming().createdAt == existing().createdAt
        && incoming().diff(existing()).affectedKeys().hasOnly(['email', 'fullName', 'isVerified', 'verificationCode', 'googleUser', 'updatedAt']);
      
      // Document Match
      match /documents/{documentId} {
        function isValidDocument(data) {
          return data.keys().hasAll(['id', 'userId', 'type', 'fileName', 'fileData', 'createdAt'])
            && data.id is string && data.id.size() <= 128
            && data.userId == request.auth.uid
            && data.type is string && data.type.size() <= 100
            && data.fileName is string && data.fileName.size() <= 255
            && data.fileData is string && data.fileData.size() <= 900000 // roughly < 1MB limit check
            && data.createdAt == request.time;
        }

        allow read: if isVerifiedUser() && request.auth.uid == userId;
        
        allow list: if isVerifiedUser() && request.auth.uid == userId && resource.data.userId == request.auth.uid;

        allow create: if isVerifiedUser()
          && isValidId(userId) && userId == request.auth.uid
          && isValidId(documentId)
          && exists(/databases/$(database)/documents/users/$(request.auth.uid))
          && isValidDocument(incoming());
          
        allow update: if isVerifiedUser()
          && request.auth.uid == userId
          && incoming().id == existing().id
          && incoming().userId == existing().userId
          && incoming().createdAt == existing().createdAt
          && isValidDocument(incoming()) // this checks createdAt == request.time which fails on update! Wait.
          && incoming().diff(existing()).affectedKeys().hasOnly(['fileSize', 'mimeType', 'uploadDate', 'fileName', 'fileData']); // wait, no updatedAt? Let's fix this in the updated schema or allow omission.
          
        allow delete: if isVerifiedUser() && request.auth.uid == userId;
      }

      // Profile Match
      match /profile/verified {
        function isValidProfile(data) {
          return data.keys().hasAll(['userId', 'fullName', 'createdAt', 'updatedAt'])
            && data.userId == request.auth.uid
            && data.fullName is string && data.fullName.size() <= 200
            && data.createdAt == request.time
            && data.updatedAt == request.time;
        }

        function isValidProfileUpdate(data) {
          return data.keys().hasAll(['userId', 'fullName', 'createdAt', 'updatedAt'])
            && data.userId == request.auth.uid
            && data.fullName is string && data.fullName.size() <= 200
            && data.updatedAt == request.time;
        }

        allow read, list: if isVerifiedUser() && request.auth.uid == userId;

        allow create: if isVerifiedUser()
          && isValidId(userId) && userId == request.auth.uid
          && exists(/databases/$(database)/documents/users/$(request.auth.uid))
          && isValidProfile(incoming());

        allow update: if isVerifiedUser()
          && request.auth.uid == userId
          && isValidProfileUpdate(incoming())
          && incoming().createdAt == existing().createdAt
          && incoming().diff(existing()).affectedKeys().hasOnly(['fullName', 'dateOfBirth', 'fatherName', 'aadhaarNumber', 'panNumber', 'updatedAt']);
      }
    }
  }
}
