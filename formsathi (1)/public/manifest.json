{
  "manifest_version": 3,
  "name": "FormSathi AI",
  "version": "1.0",
  "description": "FormSathi Document Wallet & AI Auto-Filler",
  "action": {
    "default_popup": "index.html",
    "default_title": "Open FormSathi"
  },
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "http://localhost/*",
    "https://*.run.app/*"
  ]
}
